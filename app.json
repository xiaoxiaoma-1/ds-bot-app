{
  "expo": {
    "name": "DS Bot",
    "slug": "ds-bot-app",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jinyu.dsbot",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_CN",
        "CFBundleLocalizations": ["zh_CN", "en"],
        "NSPhotoLibraryUsageDescription": "选一张照片发送给 AI，或设为你的头像",
        "NSPhotoLibraryAddUsageDescription": "保存图片到你的相册",
        "NSCameraUsageDescription": "拍一张照片发送给 AI"
      }
    }
  }
}